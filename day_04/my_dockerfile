# this is the base image the container is built on. In this case, it is a slim version of the Debian operating system.
FROM debian:trixie-slim 

# these are the labels that are added to the image. They are metadata that can be used to identify the author of the image.
LABEL image.author.name="Hanna Loh"
LABEL image.author.email="h.lohmann09@gmail.com"

# install the dependencies: update the package list and install curl and cowsay
RUN apt-get update && \
    apt-get install -y curl cowsay && \
    rm -rf /var/lib/apt/lists/*

# Download and install Salmon
RUN curl -L -o salmon.tar.gz https://github.com/COMBINE-lab/salmon/releases/download/v1.5.2/salmon-1.5.2_linux_x86_64.tar.gz && \
    tar -xzf salmon.tar.gz && \
    mv salmon-1.5.2_linux_x86_64/bin/* /usr/bin/ && \
    mv salmon-1.5.2_linux_x86_64/lib/* /usr/lib/ && \
    rm -rf salmon.tar.gz salmon-1.5.2_linux_x86_64

# cowsay is installed in /usr/games, which is not in the default PATH
ENV PATH="$PATH:/usr/games"
